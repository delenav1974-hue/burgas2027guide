---

<div class="zone-map glass-panel">
  <h3>Interactive Zone Map</h3>
  <p>Where is everything happening?</p>

  <div class="map-container">
    <!-- Placeholder for an actual SVG or interactive map -->
    <div class="map-visual">
      <div class="map-node zone-purple" style="top: 20%; left: 30%;">
        <span class="pulse"></span>
        <span class="label">Arena & Party Hub</span>
      </div>
      <div class="map-node zone-blue" style="top: 50%; left: 60%;">
        <span class="pulse"></span>
        <span class="label">Sea Garden & Center</span>
      </div>
      <div class="map-node zone-yellow" style="top: 80%; left: 80%;">
        <span class="pulse"></span>
        <span class="label">Resort Hubs (Pomorie)</span>
      </div>
      
      <!-- Faux coast line -->
      <svg class="coast-line" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0,0 Q30,50 80,100 L100,100 L100,0 Z" fill="rgba(0, 240, 255, 0.05)" stroke="var(--accent-cyan)" stroke-width="0.5"/>
      </svg>
    </div>

    <div class="zone-legend">
      <div class="legend-item">
        <span class="color-dot" style="background: #9d00ff; box-shadow: 0 0 10px #9d00ff;"></span>
        <div class="legend-text">
          <strong>Party & Arena Zone</strong>
          <span>Lazur, Slaveykov, Arena Burgas</span>
        </div>
      </div>
      <div class="legend-item">
        <span class="color-dot" style="background: var(--accent-cyan); box-shadow: 0 0 10px var(--accent-cyan);"></span>
        <div class="legend-text">
          <strong>Sea & Chill Zone</strong>
          <span>Sea Garden, Center, Beach Bars</span>
        </div>
      </div>
      <div class="legend-item">
        <span class="color-dot" style="background: var(--accent-amber); box-shadow: 0 0 10px var(--accent-amber);"></span>
        <div class="legend-text">
          <strong>Resort Hubs</strong>
          <span>Pomorie, Sarafovo, Nessebar</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .zone-map {
    margin-bottom: 32px;
  }

  .zone-map h3 {
    color: var(--accent-cyan);
    margin-bottom: 8px;
    font-size: 1.5rem;
  }

  .zone-map p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .map-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .map-visual {
    position: relative;
    height: 250px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    border: 1px solid var(--glass-border);
    overflow: hidden;
  }

  .coast-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .map-node {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transform: translate(-50%, -50%);
  }

  .pulse {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: block;
    animation: pulse-dot 2s infinite;
  }

  .zone-purple .pulse { background: #9d00ff; box-shadow: 0 0 15px #9d00ff; }
  .zone-blue .pulse { background: var(--accent-cyan); box-shadow: 0 0 15px var(--accent-cyan); }
  .zone-yellow .pulse { background: var(--accent-amber); box-shadow: 0 0 15px var(--accent-amber); }

  @keyframes pulse-dot {
    0% { transform: scale(0.95); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.8; }
    100% { transform: scale(0.95); opacity: 1; }
  }

  .map-node .label {
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    background: rgba(11, 15, 25, 0.8);
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid var(--glass-border);
  }

  .zone-legend {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .legend-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-top: 4px;
    flex-shrink: 0;
  }

  .legend-text {
    display: flex;
    flex-direction: column;
  }

  .legend-text strong {
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .legend-text span {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
