---
// Interactive Zone Map
---

<div class="zone-map-container">
  <h3>Select Your Vibe</h3>
  <div class="zone-grid">
    <a href="#area2" class="zone-block north" onclick="scrollToZone(event, 'area2')">
      <span class="icon">✈️</span>
      <span class="title">North Coast</span>
      <span class="desc">Airport & Resorts</span>
    </a>
    <a href="#area1" class="zone-block center" onclick="scrollToZone(event, 'area1')">
      <span class="icon">🎤</span>
      <span class="title">City Center</span>
      <span class="desc">Arena & Parties</span>
    </a>
    <a href="#area3" class="zone-block south" onclick="scrollToZone(event, 'area3')">
      <span class="icon">🌅</span>
      <span class="title">South Coast</span>
      <span class="desc">Riviera & History</span>
    </a>
  </div>
</div>

<script is:inline>
  function scrollToZone(e, id) {
    e.preventDefault();
    const element = document.getElementById(id);
    if (element) {
      // Offset for sticky header
      const y = element.getBoundingClientRect().top + window.scrollY - 100;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }
  }
</script>

<style>
  .zone-map-container {
    margin-bottom: 48px;
    padding: 32px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border: 1px solid var(--glass-border);
  }

  .zone-map-container h3 {
    text-align: center;
    color: var(--text-main);
    margin-bottom: 24px;
    font-size: 1.5rem;
  }

  .zone-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .zone-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    text-decoration: none;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    text-align: center;
  }

  .zone-block .icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
    filter: drop-shadow(0 0 8px rgba(255,255,255,0.2));
  }

  .zone-block .title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 4px;
  }

  .zone-block .desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Hover States */
  .zone-block.north:hover {
    border-color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.1);
    transform: translateY(-4px);
    box-shadow: 0 10px 20px -10px rgba(0, 240, 255, 0.3);
  }

  .zone-block.center:hover {
    border-color: var(--accent-magenta);
    background: rgba(255, 0, 255, 0.1);
    transform: translateY(-4px);
    box-shadow: 0 10px 20px -10px rgba(255, 0, 255, 0.3);
  }

  .zone-block.south:hover {
    border-color: var(--accent-amber);
    background: rgba(255, 184, 0, 0.1);
    transform: translateY(-4px);
    box-shadow: 0 10px 20px -10px rgba(255, 184, 0, 0.3);
  }

  @media (max-width: 768px) {
    .zone-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
