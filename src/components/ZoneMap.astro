---
// Interactive Metro-Style Coast Map
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<div class="zone-map-container">
  <div class="map-header">
    <h3>{t('map.title')}</h3>
    <p>{t('map.hint')}</p>
  </div>

  <div class="metro-map">
    
    <!-- North Coast Area -->
    <div class="metro-section">
      <div class="section-label north">{t('map.north')}</div>
      
      <div class="station" onclick="scrollToZone(event, 'area2')">
        <div class="line north-line"></div>
        <div class="node north-node"></div>
        <div class="label">
          Sunny Beach <span class="badge">{t('map.budget')}</span>
          <span class="time">🚗 40 {t('map.min')}</span>
        </div>
      </div>
      
      <div class="station" onclick="scrollToZone(event, 'area2')">
        <div class="line north-line"></div>
        <div class="node north-node"></div>
        <div class="label">
          Sveti Vlas <span class="badge">{t('map.luxury')}</span>
          <span class="time">🚗 45 {t('map.min')}</span>
        </div>
      </div>
      
      <div class="station" onclick="scrollToZone(event, 'area2')">
        <div class="line north-line"></div>
        <div class="node north-node"></div>
        <div class="label">
          Nessebar <span class="badge">{t('map.heritage')}</span>
          <span class="time">🚗 45 {t('map.min')}</span>
        </div>
      </div>
      
      <div class="station" onclick="scrollToZone(event, 'area2')">
        <div class="line north-line"></div>
        <div class="node north-node"></div>
        <div class="label">
          Pomorie <span class="badge">{t('map.relaxed')}</span>
          <span class="time">🚗 30 {t('map.min')}</span>
        </div>
      </div>
    </div>

    <!-- City Center Area -->
    <div class="metro-section">
      <div class="section-label center">{t('map.city')}</div>
      
      <div class="station" onclick="scrollToZone(event, 'area1')">
        <div class="line center-line"></div>
        <div class="node center-node">✈️</div>
        <div class="label">
          Sarafovo <span class="badge airport">{t('map.airport')}</span>
          <span class="time">🚌 15 {t('map.min')}</span>
        </div>
      </div>

      <div class="station" onclick="scrollToZone(event, 'area1')">
        <div class="line center-line"></div>
        <div class="node center-node highlight">🎤</div>
        <div class="label">
          Zornitsa / Izgrev <span class="badge primary">{t('map.arena')}</span>
          <span class="time">🚶 10 {t('map.min')}</span>
        </div>
      </div>

      <div class="station" onclick="scrollToZone(event, 'area1')">
        <div class="line center-line"></div>
        <div class="node center-node"></div>
        <div class="label">
          Lazur <span class="badge">{t('map.seagarden')}</span>
          <span class="time">🚶 25 {t('map.min')}</span>
        </div>
      </div>

      <div class="station" onclick="scrollToZone(event, 'area1')">
        <div class="line center-line"></div>
        <div class="node center-node">🏙️</div>
        <div class="label">
          City Center <span class="badge secondary">{t('map.eurovillage')}</span>
          <span class="time">🚌 15 {t('map.min')}</span>
        </div>
      </div>
      
      <div class="station" onclick="scrollToZone(event, 'area1')">
        <div class="line center-line"></div>
        <div class="node center-node"></div>
        <div class="label">
          Kraimorie <span class="badge">{t('map.beach')}</span>
          <span class="time">🚌 25 {t('map.min')}</span>
        </div>
      </div>
    </div>

    <!-- South Coast Area -->
    <div class="metro-section">
      <div class="section-label south">{t('map.south')}</div>
      
      <div class="station" onclick="scrollToZone(event, 'area3')">
        <div class="line south-line"></div>
        <div class="node south-node"></div>
        <div class="label">
          Chernomorets <span class="badge">{t('map.quiet')}</span>
          <span class="time">🚗 35 {t('map.min')}</span>
        </div>
      </div>
      
      <div class="station" onclick="scrollToZone(event, 'area3')">
        <div class="line south-line"></div>
        <div class="node south-node"></div>
        <div class="label">
          Sozopol <span class="badge">{t('map.riviera')}</span>
          <span class="time">🚗 50 {t('map.min')}</span>
        </div>
      </div>
    </div>
    
  </div>
</div>

<script is:inline>
  function scrollToZone(e, id) {
    e.preventDefault();
    const element = document.getElementById(id);
    if (element) {
      const y = element.getBoundingClientRect().top + window.scrollY - 100;
      window.scrollTo({ top: y, behavior: 'smooth' });
      
      element.style.transition = 'box-shadow 0.5s ease';
      element.style.boxShadow = '0 0 30px rgba(0, 240, 255, 0.5)';
      setTimeout(() => {
        element.style.boxShadow = 'none';
      }, 1000);
    }
  }
</script>

<style>
  .zone-map-container {
    margin-bottom: 48px;
    padding: 32px 24px;
    background: rgba(10, 10, 25, 0.6);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  }

  .map-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .map-header h3 {
    color: var(--text-main);
    margin-bottom: 8px;
    font-size: 1.5rem;
  }

  .map-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .metro-map {
    display: flex;
    flex-direction: column;
    max-width: 400px;
    margin: 0 auto;
    position: relative;
  }

  .metro-section {
    position: relative;
    margin-bottom: 16px;
  }

  .section-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    margin-bottom: 16px;
    margin-left: 50px;
  }

  .section-label.north { color: var(--accent-cyan); }
  .section-label.center { color: var(--accent-magenta); }
  .section-label.south { color: var(--accent-amber); }

  .station {
    display: flex;
    align-items: center;
    position: relative;
    height: 48px;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .station:hover {
    transform: translateX(10px);
  }

  .station:hover .label {
    color: #fff;
    text-shadow: 0 0 10px rgba(255,255,255,0.5);
  }

  .line {
    position: absolute;
    left: 15px;
    top: -24px;
    bottom: -24px;
    width: 6px;
    z-index: 1;
  }

  /* Fix line ends */
  .metro-section:first-child .station:first-child .line { top: 50%; }
  .metro-section:last-child .station:last-child .line { bottom: 50%; }

  .north-line { background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-cyan)); }
  .center-line { background: linear-gradient(to bottom, var(--accent-magenta), var(--accent-magenta)); }
  .south-line { background: linear-gradient(to bottom, var(--accent-amber), var(--accent-amber)); }

  /* Gradient transitions between sections */
  .metro-section:nth-child(1) .station:last-child .line {
    background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-magenta));
    bottom: -40px;
  }
  .metro-section:nth-child(2) .station:last-child .line {
    background: linear-gradient(to bottom, var(--accent-magenta), var(--accent-amber));
    bottom: -40px;
  }

  .node {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #111;
    border: 4px solid #fff;
    margin-left: 10px;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .north-node { border-color: var(--accent-cyan); }
  .center-node { border-color: var(--accent-magenta); }
  .south-node { border-color: var(--accent-amber); }

  .node.highlight {
    width: 24px;
    height: 24px;
    margin-left: 6px;
    background: #fff;
    box-shadow: 0 0 15px var(--accent-magenta);
  }

  .label {
    margin-left: 24px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-main);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .badge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .badge.primary {
    background: rgba(255, 0, 255, 0.2);
    color: var(--accent-magenta);
    border: 1px solid rgba(255, 0, 255, 0.3);
  }

  .badge.secondary {
    background: rgba(0, 240, 255, 0.2);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 240, 255, 0.3);
  }
  
  .badge.airport {
    background: rgba(255, 184, 0, 0.2);
    color: var(--accent-amber);
    border: 1px solid rgba(255, 184, 0, 0.3);
  }

  .time {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: normal;
    white-space: nowrap;
  }
</style>
