---
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { SITE } from '../config/site';

interface Props {
  headline: string;
  subheadline: string;
}

const { headline, subheadline } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Send the reader back to the home page of the language they signed up in.
const redirectTo = new URL(localizedPath('', locale), SITE.url).href;
---

<section class="hero-capture">
  <div class="hero-content">
    <h1 class="text-gradient">{headline}</h1>
    <p class="subheadline">{subheadline}</p>
    
    <div class="capture-box glass-panel">
      <h3>{t('hero.waitlist')}</h3>
      <p>{t('hero.waitlistText')}</p>
      
      <form class="capture-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="03b548cb-5509-4e30-91a0-785800f9f395">
        <input type="email" name="email" placeholder={t('hero.emailPlaceholder')} required />
        <input type="hidden" name="redirect" value={redirectTo}>
        <input type="hidden" name="subject" value={`New Subscriber (${locale.toUpperCase()}) from Hero Section!`}>
        <button type="submit" class="btn btn-primary">{t('hero.cta')}</button>
      </form>
      <div class="spam-notice">{t('hero.privacy')}</div>
      
      <div class="telegram-banner">
        <p>{t('hero.telegramPitch')}</p>
        <a href="https://t.me/burgas2027guide" target="_blank" rel="noopener noreferrer" class="btn btn-telegram">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
          {t('hero.telegramCta')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-capture {
    padding: 80px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
    /* JPEG first as the universal fallback; image-set upgrades to WebP
       in every browser that understands it (~96% of traffic). */
    background-image: linear-gradient(to bottom, rgba(5, 5, 20, 0.6), rgba(5, 5, 20, 0.95)),
      url('/images/hero-bg.jpg');
    background-image: linear-gradient(to bottom, rgba(5, 5, 20, 0.6), rgba(5, 5, 20, 0.95)),
      image-set(url('/images/hero-bg.webp') type('image/webp'),
                url('/images/hero-bg.jpg') type('image/jpeg'));
    background-size: cover;
    background-position: center 20%;
    border-radius: 16px;
    margin-top: 10px;
    margin-bottom: 24px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Optional background effect */
  .hero-capture::before {
    content: '';
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255,0,122,0.15) 0%, rgba(0,0,0,0) 70%);
    z-index: -1;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    font-size: 3.5rem;
    margin-bottom: 24px;
    line-height: 1.1;
  }

  .subheadline {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 48px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .capture-box {
    max-width: 500px;
    margin: 0 auto;
    padding: 32px;
  }

  .capture-box h3 {
    margin-bottom: 12px;
    font-size: 1.5rem;
  }

  .capture-box p {
    margin-bottom: 24px;
    font-size: 0.95rem;
  }

  .capture-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .capture-form input {
    padding: 16px;
    border-radius: 8px;
    border: 1px solid var(--glass-border);
    background: rgba(0, 0, 0, 0.5);
    color: var(--text-main);
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .capture-form input:focus {
    border-color: var(--accent-cyan);
  }

  .spam-notice {
    margin-top: 16px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .telegram-banner {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px dashed var(--glass-border);
  }

  .telegram-banner p {
    font-size: 0.9rem;
    margin-bottom: 12px;
    color: var(--text-main);
  }

  .btn-telegram {
    background: #0088cc;
    color: white;
    width: 100%;
    font-size: 0.95rem;
  }

  .btn-telegram:hover {
    background: #0077b5;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 136, 204, 0.4);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
