---
interface Props {
  percentage: number;
}

const { percentage } = Astro.props;
---

<div class="occupancy-meter glass-panel">
  <div class="meter-header">
    <h3>Live Occupancy Barometer</h3>
    <span class="pulse-indicator"></span>
  </div>
  
  <p class="status-text">
    Burgas Hotels: <strong>{percentage}% Booked.</strong> Check verified private apartments before price surge.
  </p>

  <div class="progress-bar-container">
    <div class="progress-bar" style={`width: ${percentage}%`}></div>
  </div>
</div>

<style>
  .occupancy-meter {
    margin-bottom: 32px;
    border: 1px solid var(--accent-magenta);
    background: rgba(22, 29, 47, 0.8);
  }

  .meter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .meter-header h3 {
    font-size: 1.2rem;
    color: var(--accent-amber);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  .pulse-indicator {
    width: 12px;
    height: 12px;
    background-color: var(--accent-magenta);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-magenta);
    animation: pulse 1.5s infinite alternate;
  }

  @keyframes pulse {
    0% { opacity: 0.5; box-shadow: 0 0 5px var(--accent-magenta); }
    100% { opacity: 1; box-shadow: 0 0 15px var(--accent-magenta); }
  }

  .status-text {
    font-size: 1rem;
    margin-bottom: 16px;
    color: var(--text-main);
  }

  .status-text strong {
    color: var(--accent-magenta);
    font-size: 1.1rem;
  }

  .progress-bar-container {
    width: 100%;
    height: 16px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-magenta), #ff4d4d);
    border-radius: 8px;
    transition: width 1s ease-in-out;
  }
</style>
