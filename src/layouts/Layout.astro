---
import '../styles/global.css';
import { SITE } from '../config/site';
import { LOCALES, LOCALE_NAMES, LOCALE_SHORT, LOCALE_TAGS, DEFAULT_LOCALE } from '../i18n/ui';
import {
  getLocaleFromUrl,
  useTranslations,
  stripLocale,
  localizedPath,
  isLocalizedRoute,
  switchTarget,
} from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Page-specific JSON-LD (Event, FAQPage, Article...). Object or array. */
  schema?: object | object[];
  /** Human label for this page in the breadcrumb trail. */
  breadcrumb?: string;
}

const {
  title,
  description,
  image = SITE.defaultImage,
  schema,
  breadcrumb,
} = Astro.props;

// Canonical: always the trailing-slash form on the production origin,
// stripped of query strings and fragments.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '';
const canonicalURL = new URL(canonicalPath + '/', SITE.url).href;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const route = stripLocale(canonicalPath);

// hreflang is only emitted where a real translation exists in every locale.
// Advertising an alternate that 404s is worse than advertising none.
const alternates = isLocalizedRoute(route)
  ? LOCALES.map((l) => ({
      hreflang: LOCALE_TAGS[l],
      href: new URL(localizedPath(route, l), SITE.url).href,
    }))
  : [];
const xDefault = isLocalizedRoute(route)
  ? new URL(localizedPath(route, DEFAULT_LOCALE), SITE.url).href
  : null;

// Nav destinations: translated pages switch with the reader, the rest stay
// on their English URLs because that is where the content actually lives.
const navHref = (r: string) =>
  isLocalizedRoute(r) ? localizedPath(r, locale) : `/${r}/`;

const homeLabel = { en: 'Home', ru: 'Главная', bg: 'Начало' }[locale];

// Breadcrumb trail, built from the URL. Home-only pages get no trail.
const segments = canonicalPath.split('/').filter(Boolean);
const breadcrumbSchema =
  segments.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: homeLabel,
            item: `${SITE.url}/`,
          },
          ...segments.map((seg, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name:
              i === segments.length - 1 && breadcrumb
                ? breadcrumb
                : seg
                    .split('-')
                    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
                    .join(' '),
            item: `${SITE.url}/${segments.slice(0, i + 1).join('/')}/`,
          })),
        ],
      }
    : null;

// Site-wide identity graph: emitted once, on every page.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description: SITE.description,
      inLanguage: LOCALE_TAGS[locale],
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: `${SITE.url}${SITE.logo}`,
      sameAs: [SITE.telegram],
    },
  ],
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [siteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...pageSchemas];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload the hero art so it is not discovered late -->
    <link rel="preload" as="image" href="/images/hero-bg.webp" type="image/webp" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />
    
    <!-- GTranslate -->
    <script type="text/javascript">
      // Russian and Bulgarian are served as real, indexable pages (/ru/, /bg/),
      // so they are removed here — machine translation would compete with them.
      // GTranslate stays for languages we do not hand-translate.
      window.gtranslateSettings = {"default_language":"en","native_language_names":true,"languages":["en","tr","de","fr","it","es"],"wrapper_selector":".gtranslate_wrapper"};
    </script>
    <script src="https://cdn.gtranslate.net/widgets/latest/dwf.js" defer></script>
    
    <!-- Travelpayouts Drive Script -->
    <script nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://emrldtp.cc/NTYzNjAw.js?t=563600';
          document.head.appendChild(script);
      })();
    </script>

    <!-- Structured data -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <header class="site-header glass-panel">
      <div class="container">
        <a href="/" class="logo">
          <span class="text-gradient">Burgas 2027</span> Guide
        </a>
        <button
          class="nav-toggle"
          id="nav-toggle"
          aria-label={t('nav.open')}
          aria-expanded="false"
          aria-controls="main-nav"
          data-label-open={t('nav.open')}
          data-label-close={t('nav.close')}
        >
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <nav class="main-nav" id="main-nav">
          <a href={navHref('news')}>{t('nav.news')}</a>
          <a href={navHref('where-to-stay')}>{t('nav.stay')}</a>
          <a href={navHref('transfers')}>{t('nav.transport')}</a>
          <a href={navHref('events-and-parties')}>{t('nav.events')}</a>
          <a href={navHref('black-sea-experience')}>{t('nav.experience')}</a>
          <a href={navHref('faq')} class="text-cyan-400 font-bold">{t('nav.faq')}</a>
          <a href={navHref('essential-apps')} class="text-pink-400">{t('nav.apps')}</a>
        </nav>
        <div class="lang-switch" aria-label={t('lang.label')}>
          {LOCALES.map((l) => (
            <a
              href={switchTarget(Astro.url.pathname, l)}
              class={l === locale ? 'lang-active' : ''}
              hreflang={LOCALE_TAGS[l]}
              lang={LOCALE_TAGS[l]}
              aria-current={l === locale ? 'true' : undefined}
              aria-label={LOCALE_NAMES[l]}
              title={LOCALE_NAMES[l]}
            >
              {LOCALE_SHORT[l]}
            </a>
          ))}
        </div>
        <div class="gtranslate_wrapper"></div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="disclaimer">
            <div class="about-copy">
              <h4>{t('footer.team')}</h4>
              <p>{t('footer.about')}</p>
            </div>
            <p style="margin-top: 16px;">
              <em>{t('footer.disclaimer')}</em>
            </p>
          </div>
          <div class="b2b-links">
            <h4>{t('footer.community')}</h4>
            <ul>
              <li><a href="https://t.me/burgas2027guide" target="_blank" rel="noopener noreferrer">{t('footer.telegram')}</a></li>
              <li><a href="/about/" class="discreet-b2b-link">{t('footer.contact')}</a></li>
              <li><a href="/privacy/" class="discreet-b2b-link">{t('footer.privacy')}</a></li>
              <li><a href="/terms/" class="discreet-b2b-link">{t('footer.terms')}</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>{t('footer.partner')}</h4>
            <ul>
              <li><a href="/investors/">{t('footer.investors')}</a></li>
              <li><a href="/disclosure/">{t('footer.disclosure')}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        border-radius: 0;
        border-left: none;
        border-right: none;
        border-top: none;
        padding: 16px 0;
      }
      
      .site-header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
      }

      .logo {
        white-space: nowrap;
        font-family: 'Outfit', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
      }

      .main-nav {
        display: flex;
        gap: 24px;
        align-items: center;
      }

      .main-nav a {
        font-weight: 600;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .gtranslate_wrapper {
        min-width: 120px;
      }

      /* Hand-translated locales get a real switcher; GTranslate keeps the
         machine-translated remainder next to it. */
      .lang-switch {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 2px;
        border: 1px solid var(--glass-border);
        border-radius: 999px;
      }

      .lang-switch a {
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: none;
        letter-spacing: 0;
        white-space: nowrap;
      }

      .lang-switch a:hover {
        color: var(--text-main);
        text-shadow: none;
      }

      .lang-switch a.lang-active {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.1);
      }

      main {
        flex: 1;
      }

      .site-footer {
        margin-top: 64px;
        padding: 48px 0;
        background-color: rgba(0, 0, 0, 0.5);
        border-top: 1px solid var(--glass-border);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 32px;
      }

      .disclaimer {
        color: var(--text-muted);
        font-size: 0.85rem;
      }

      .about-copy {
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px dashed var(--glass-border);
      }

      .about-copy h4 {
        color: var(--accent-amber);
        margin-bottom: 8px;
        font-size: 1rem;
      }

      .about-copy p {
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--text-main);
      }

      .b2b-links h4 {
        margin-bottom: 16px;
        color: var(--accent-magenta);
      }

      .b2b-links ul {
        list-style: none;
      }

      .b2b-links li {
        margin-bottom: 8px;
      }

      .discreet-b2b-link {
        color: var(--text-muted);
        font-size: 0.8rem;
        text-transform: none;
        opacity: 0.7;
      }

      .discreet-b2b-link:hover {
        opacity: 1;
        color: var(--accent-amber);
        text-shadow: none;
      }

      /* Hamburger — hidden on desktop, shown below 900px */
      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        padding: 0;
        background: transparent;
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        cursor: pointer;
      }

      .nav-toggle-bar {
        display: block;
        width: 20px;
        height: 2px;
        margin: 0 auto;
        background: var(--text-main);
        border-radius: 2px;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }

      .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
        opacity: 0;
      }
      .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      @media (max-width: 1300px) {
        .site-header .container {
          flex-wrap: wrap;
          gap: 12px;
        }

        .nav-toggle {
          display: flex;
          order: 3;
        }

        .lang-switch {
          order: 2;
          margin-left: auto;
        }

        .gtranslate_wrapper {
          order: 5;
          flex-basis: 100%;
          min-width: 0;
        }

        .lang-switch a {
          padding: 7px 10px;
        }

        .main-nav {
          order: 4;
          flex-basis: 100%;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.3s ease;
        }

        .main-nav.is-open {
          max-height: 70vh;
          overflow-y: auto;
          margin-top: 8px;
          border-top: 1px solid var(--glass-border);
        }

        .main-nav a {
          padding: 14px 4px;
          font-size: 1rem;
          border-bottom: 1px solid var(--glass-border);
        }

        .main-nav a:last-child {
          border-bottom: none;
        }
      }

      @media (max-width: 768px) {
        .footer-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('main-nav');

      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            (open
              ? toggle.dataset.labelClose
              : toggle.dataset.labelOpen) ?? 'Navigation menu'
          );
        });

        // Close the menu when a link is followed or Escape is pressed.
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') {
            nav.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('is-open')) {
            nav.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
