---
import Layout from '../layouts/Layout.astro';
import HeroCapture from '../components/HeroCapture.astro';
import CountdownBanner from '../components/CountdownBanner.astro';
import TripPlanner from '../components/TripPlanner.astro';
import { getCollection } from 'astro:content';
import { eventSchema } from '../config/site';

const targetDate = "2027-05-15T20:00:00+03:00"; // Assuming 20:00 EEST

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout 
  title="Burgas 2027 Guide | The Ultimate Eurovision Fan Portal" 
  description="Independent guide for Burgas 2027. Find the best arena accommodation, airport transfers, and secret local spots for the Eurovision Song Contest."
  schema={eventSchema}
>
  <div class="container">
    <HeroCapture 
      headline="Your Ultimate Guide to Burgas 2027"
      subheadline="The independent local playbook for surviving and thriving during the biggest music event on the Black Sea coast."
    />

    <CountdownBanner targetDate={targetDate} />

    <TripPlanner />

    {latestNews.length > 0 && (
      <section class="latest-news-section glass-panel" style="margin: 64px 0; padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <h2 style="color: var(--accent-magenta); font-size: 2rem;">Latest Updates</h2>
          <a href="/news" style="color: var(--accent-cyan); font-weight: 600;">View All &rarr;</a>
        </div>
        <div class="news-list" style="display: flex; flex-direction: column; gap: 16px;">
          {latestNews.map((post) => (
            <a href={`/news/${post.id}`} class="news-item" style="display: block; padding: 16px; background: rgba(0,0,0,0.3); border-radius: 8px; text-decoration: none; border: 1px solid var(--glass-border); transition: border-color 0.2s;">
              <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </div>
              <h3 style="color: var(--text-main); margin-bottom: 8px; font-size: 1.2rem;">{post.data.title}</h3>
              <p style="color: var(--text-muted); font-size: 0.95rem;">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .news-item:hover {
    border-color: var(--accent-cyan) !important;
  }
</style>

