---
import Layout from '../layouts/Layout.astro';
import HeroCapture from '../components/HeroCapture.astro';
import CountdownBanner from '../components/CountdownBanner.astro';
import OccupancyMeter from '../components/OccupancyMeter.astro';
import TransitCalculator from '../components/TransitCalculator.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import { getCollection } from 'astro:content';

const targetDate = "2027-05-15T20:00:00+03:00"; // Assuming 20:00 EEST

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout 
  title="Burgas 2027 Guide | The Ultimate Eurovision Fan Portal" 
  description="Independent guide for Burgas 2027. Find the best arena accommodation, airport transfers, and secret local spots for the Eurovision Song Contest."
>
  <div class="container">
    <HeroCapture 
      headline="Your Ultimate Guide to Burgas 2027"
      subheadline="The independent local playbook for surviving and thriving during the biggest music event on the Black Sea coast."
    />

    <div class="quick-links glass-panel" style="margin-top: -32px; margin-bottom: 32px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; padding: 24px;">
      <a href="/where-to-stay" class="btn btn-secondary">🏨 Find Accommodation</a>
      <a href="/transfers" class="btn btn-secondary">🚕 Book Airport Transfer</a>
      <AffiliateButton text="📱 Get Tourist eSIM (Airalo)" href="https://www.airalo.com/bulgaria-esim" provider="generic" />
    </div>

    <CountdownBanner targetDate={targetDate} />

    <section class="features">
      <div class="feature-card glass-panel">
        <h3>📍 Where to Stay</h3>
        <p>Avoid the tourist traps. We map out the best <strong>hotels walking distance to arena burgas</strong> and coastal shuttle towns.</p>
        <OccupancyMeter percentage={82} />
        <a href="/where-to-stay" class="btn btn-primary" style="margin-top:16px;">View Lodging Guide</a>
      </div>

      <div class="feature-card glass-panel">
        <h3>🚕 Transit & Logistics</h3>
        <p>Master your commute. From <strong>bus from istanbul new airport to burgas timetable</strong> to official night shuttles.</p>
        <TransitCalculator />
        <a href="/transfers" class="btn btn-primary" style="margin-top:16px;">View Transit Hub</a>
      </div>
      
      <div class="feature-card glass-panel">
        <h3>🪩 Events & Parties</h3>
        <p>Discover the EuroVillage, official EuroClub afterparties, and VIP yacht events departing from the Port of Burgas.</p>
        <a href="/events-and-parties" class="btn btn-primary" style="margin-top:16px; display: block;">See the Schedule</a>
      </div>
    </section>

    {latestNews.length > 0 && (
      <section class="latest-news-section glass-panel" style="margin: 64px 0; padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <h2 style="color: var(--accent-magenta); font-size: 2rem;">Latest Updates</h2>
          <a href="/news" style="color: var(--accent-cyan); font-weight: 600;">View All &rarr;</a>
        </div>
        <div class="news-list" style="display: flex; flex-direction: column; gap: 16px;">
          {latestNews.map((post) => (
            <a href={`/news/${post.slug}`} class="news-item" style="display: block; padding: 16px; background: rgba(0,0,0,0.3); border-radius: 8px; text-decoration: none; border: 1px solid var(--glass-border); transition: border-color 0.2s;">
              <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </div>
              <h3 style="color: var(--text-main); margin-bottom: 8px; font-size: 1.2rem;">{post.data.title}</h3>
              <p style="color: var(--text-muted); font-size: 0.95rem;">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    margin: 64px 0;
  }

  .feature-card h3 {
    color: var(--accent-amber);
    margin-bottom: 16px;
    font-size: 1.5rem;
  }

  .feature-card p {
    font-size: 1.05rem;
    margin-bottom: 24px;
  }

  .news-item:hover {
    border-color: var(--accent-cyan) !important;
  }
</style>
