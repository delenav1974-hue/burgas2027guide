---
import Layout from '../layouts/Layout.astro';
import { eventSchema } from '../config/site';
---

<Layout 
  title="Eurovision VIP Transfers | Burgas 2027" 
  description="Book premium airport meet & greet, Mercedes V-Class transfers, and delegation transportation for Eurovision 2027 in Burgas."
  breadcrumb="VIP Transfers"
>
  <div class="container page-content">
    <h1 class="text-gradient">Eurovision VIP Transfers</h1>
    <p class="lead">Premium airport meet & greet, multi-day driver hire, and delegation transportation from Sofia or Istanbul directly to your hotel in Burgas.</p>

    <div class="content-grid">
      <div class="main-column">
        <div class="glass-panel mb-4">
          <h2>Premium Fleet & Services</h2>
          <p>We provide exclusive transportation for delegations, media, and VIP fans who require privacy, comfort, and reliability.</p>
          <ul style="margin-top: 16px; margin-bottom: 24px; line-height: 1.8;">
            <li><strong>Mercedes V-Class:</strong> Luxury minivans perfect for groups up to 6 people with heavy luggage.</li>
            <li><strong>Airport Meet & Greet:</strong> Our drivers wait for you at the arrivals hall with a name sign at Sofia (SOF), Istanbul (IST), or Burgas (BOJ).</li>
            <li><strong>Multi-day Driver:</strong> Hire a driver for your entire stay to shuttle you between your hotel, the Arena, and the EuroVillage.</li>
            <li><strong>Delegation Support:</strong> Coordinated transport for large groups with multiple vehicles.</li>
          </ul>
        </div>
      </div>

      <aside class="sidebar">
        <div class="glass-panel sticky-box">
          <h3>Request a VIP Quote</h3>
          <p style="font-size: 0.9rem; margin-bottom: 24px; color: var(--text-muted);">Fill out the form below and our local dispatcher will reply within 24 hours with a custom quote.</p>
          
          <form action="https://api.web3forms.com/submit" method="POST" class="quote-form">
            <input type="hidden" name="access_key" value="03b548cb-5509-4e30-91a0-785800f9f395" />
            <input type="hidden" name="subject" value="New VIP Transfer Quote Request" />
            
            <div class="form-group">
              <label>Name / Delegation</label>
              <input type="text" name="name" required placeholder="John Doe" />
            </div>

            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" required placeholder="john@example.com" />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Arrival Date</label>
                <input type="date" name="arrival_date" required />
              </div>
              <div class="form-group">
                <label>Passengers</label>
                <input type="number" name="passengers" min="1" max="50" required placeholder="4" />
              </div>
            </div>

            <div class="form-group">
              <label>Pickup Location (Airport/City)</label>
              <input type="text" name="pickup" required placeholder="e.g. Sofia Airport (SOF)" />
            </div>

            <div class="form-group">
              <label>Drop-off Hotel in Burgas</label>
              <input type="text" name="dropoff" required placeholder="e.g. Grand Hotel Promorie" />
            </div>
            
            <div class="form-group">
              <label>Vehicle Preference</label>
              <select name="vehicle">
                <option value="Sedan">Premium Sedan (1-3 pax)</option>
                <option value="V-Class" selected>Mercedes V-Class (4-6 pax)</option>
                <option value="Minibus">Minibus (7-15 pax)</option>
                <option value="Coach">Full Coach (Delegation)</option>
              </select>
            </div>

            <div class="form-group checkbox-group">
              <label>
                <input type="checkbox" name="return_transfer" value="Yes" />
                Include Return Transfer
              </label>
            </div>

            <div class="form-group">
              <label>Luggage / Special Requests</label>
              <textarea name="requests" rows="3" placeholder="Number of bags, bulky equipment, etc."></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">GET A VIP QUOTE</button>
          </form>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    padding: 64px 24px;
  }
  
  h1 {
    font-size: 3rem;
    margin-bottom: 16px;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 800px;
    margin-bottom: 48px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }

  .quote-form .form-group {
    margin-bottom: 16px;
  }

  .quote-form .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .quote-form label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .quote-form input[type="text"],
  .quote-form input[type="email"],
  .quote-form input[type="date"],
  .quote-form input[type="number"],
  .quote-form select,
  .quote-form textarea {
    width: 100%;
    padding: 10px 12px;
    background: rgba(0,0,0,0.2);
    border: 1px solid var(--glass-border);
    border-radius: 4px;
    color: var(--text-main);
    font-family: inherit;
  }

  .quote-form input:focus,
  .quote-form select:focus,
  .quote-form textarea:focus {
    outline: none;
    border-color: var(--accent-cyan);
  }

  .checkbox-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    text-transform: none;
    font-size: 0.95rem;
    cursor: pointer;
  }
  
  .checkbox-group input {
    cursor: pointer;
  }
</style>
