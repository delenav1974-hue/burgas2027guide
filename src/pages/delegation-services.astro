---
import Layout from '../layouts/Layout.astro';
import { eventSchema } from '../config/site';
---

<Layout 
  title="Eurovision Delegation Services Burgas | B2B Logistics" 
  description="Comprehensive B2B logistics and delegation services for Eurovision 2027. We provide hotel blocks, security, private transport, and interpreters in Burgas."
  breadcrumb="Delegations"
>
  <div class="container page-content">
    <div style="text-align: center; max-width: 900px; margin: 0 auto 64px;">
      <h1 class="text-gradient" style="font-size: 3.5rem; margin-bottom: 24px;">Delegation & Media Services</h1>
      <p class="lead" style="font-size: 1.2rem; color: var(--text-muted);">Burgas 2027 Guide acts as your on-the-ground B2B partner. We provide full-scale logistical support for national broadcasters, official delegations, corporate sponsors, and large media groups.</p>
    </div>

    <div class="content-grid">
      <div class="main-column">
        <div class="glass-panel mb-4">
          <h2>Our B2B Capabilities</h2>
          <p>Moving a delegation of 40+ people across Europe requires flawless execution. Our local team leverages deep regional connections to secure the infrastructure you need, long before it becomes publicly available.</p>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 32px;">
            <div class="capability-box">
              <h4 style="color: var(--accent-cyan); margin-bottom: 8px;">🏨 Accommodation</h4>
              <ul style="font-size: 0.95rem; color: var(--text-muted); padding-left: 20px;">
                <li>Large Hotel Blocks (50+ rooms)</li>
                <li>Exclusive Villa Rentals</li>
                <li>Long-term Apartment Leases</li>
                <li>Private Meeting Rooms</li>
              </ul>
            </div>
            <div class="capability-box">
              <h4 style="color: var(--accent-amber); margin-bottom: 8px;">🚕 Transport & Security</h4>
              <ul style="font-size: 0.95rem; color: var(--text-muted); padding-left: 20px;">
                <li>Fleet of Mercedes V-Class Minivans</li>
                <li>Dedicated 24/7 Drivers</li>
                <li>Airport Coach Transfers</li>
                <li>Private Security Details</li>
              </ul>
            </div>
            <div class="capability-box">
              <h4 style="color: var(--accent-magenta); margin-bottom: 8px;">🥂 Hospitality & Events</h4>
              <ul style="font-size: 0.95rem; color: var(--text-muted); padding-left: 20px;">
                <li>Private Restaurant Buyouts</li>
                <li>Catering & Craft Services</li>
                <li>VIP Afterparty Organization</li>
                <li>Private Yacht Charters</li>
              </ul>
            </div>
            <div class="capability-box">
              <h4 style="color: white; margin-bottom: 8px;">🗣️ Local Support</h4>
              <ul style="font-size: 0.95rem; color: var(--text-muted); padding-left: 20px;">
                <li>Professional Interpreters</li>
                <li>Local Fixers & Runners</li>
                <li>Equipment Rental & Logistics</li>
                <li>Press Photographers</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <aside class="sidebar">
        <div class="glass-panel sticky-box" style="background: rgba(0, 240, 255, 0.05); border-color: rgba(0, 240, 255, 0.3);">
          <h3>Request a Consultation</h3>
          <p style="font-size: 0.9rem; margin-bottom: 24px; color: var(--text-muted);">Please provide high-level details about your delegation size and requirements. Our B2B manager will contact you.</p>
          
          <form action="https://api.web3forms.com/submit" method="POST" class="b2b-form">
            <input type="hidden" name="access_key" value="03b548cb-5509-4e30-91a0-785800f9f395" />
            <input type="hidden" name="subject" value="New B2B Delegation Request" />
            
            <div class="form-group">
              <input type="text" name="organization" required placeholder="Organization / Broadcaster" />
            </div>
            <div class="form-group">
              <input type="text" name="name" required placeholder="Contact Person" />
            </div>
            <div class="form-group">
              <input type="email" name="email" required placeholder="Work Email" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <input type="number" name="group_size" required placeholder="Group Size" />
              </div>
              <div class="form-group">
                <input type="text" name="country" required placeholder="Country" />
              </div>
            </div>
            <div class="form-group">
              <textarea name="requirements" rows="6" placeholder="Briefly describe your requirements (e.g. 40 hotel rooms, 3 minivans, 1 interpreter...)" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">SUBMIT RFP</button>
          </form>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    padding: 64px 24px;
  }
  
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 32px;
  }

  .capability-box {
    background: rgba(0,0,0,0.2);
    padding: 24px;
    border-radius: 8px;
    border: 1px solid var(--glass-border);
  }

  .b2b-form .form-group {
    margin-bottom: 16px;
  }

  .b2b-form .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .b2b-form input,
  .b2b-form textarea {
    width: 100%;
    padding: 12px 16px;
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--glass-border);
    border-radius: 4px;
    color: var(--text-main);
    font-family: inherit;
  }

  .b2b-form input:focus,
  .b2b-form textarea:focus {
    outline: none;
    border-color: var(--accent-cyan);
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
