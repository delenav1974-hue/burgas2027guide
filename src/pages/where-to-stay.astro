---
import Layout from '../layouts/Layout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import ZoneMap from '../components/ZoneMap.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
---

<Layout 
  title="Where to Stay in Burgas 2027 | Arena Accommodation & Hotels" 
  description="Discover the best places to stay for Eurovision 2027 in Burgas. From arena walking-distance hotels to coastal shuttle towns like Pomorie and Sozopol."
  breadcrumb="Where to Stay"
>
  <div class="container page-content">
    <h1 class="text-gradient">Burgas 2027 Accommodation Hub</h1>
    <p class="lead">Where fans and tourists should stay: neighborhood breakdowns, proximity to the Arena, night logistics, and trusted accommodation options.</p>

    <div class="content-grid">
      <div class="main-column">
        <div class="glass-panel mb-4" style="overflow-x: auto;">
          <h2 style="border:none; margin-bottom: 16px;">At a Glance: Best Areas</h2>
          <table style="width: 100%; text-align: left; border-collapse: collapse; min-width: 600px;">
            <thead>
              <tr style="border-bottom: 2px solid var(--accent-magenta); color: var(--accent-cyan);">
                <th style="padding: 12px;">Area</th>
                <th style="padding: 12px;">Arena</th>
                <th style="padding: 12px;">Nightlife</th>
                <th style="padding: 12px;">Beach</th>
                <th style="padding: 12px;">Price</th>
                <th style="padding: 12px;">Best for</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--glass-border);">
                <td style="padding: 12px;"><strong>Zornitsa / Izgrev</strong></td>
                <td style="padding: 12px;">⭐⭐⭐⭐⭐</td>
                <td style="padding: 12px;">⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐</td>
                <td style="padding: 12px;">€€€</td>
                <td style="padding: 12px;">Eurovision</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--glass-border);">
                <td style="padding: 12px;"><strong>Lazur</strong></td>
                <td style="padding: 12px;">⭐⭐⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐⭐⭐</td>
                <td style="padding: 12px;">€€€</td>
                <td style="padding: 12px;">Couples</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--glass-border);">
                <td style="padding: 12px;"><strong>City Center</strong></td>
                <td style="padding: 12px;">⭐⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐⭐</td>
                <td style="padding: 12px;">€€€</td>
                <td style="padding: 12px;">Parties</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--glass-border);">
                <td style="padding: 12px;"><strong>Sarafovo</strong></td>
                <td style="padding: 12px;">⭐⭐</td>
                <td style="padding: 12px;">⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐⭐⭐</td>
                <td style="padding: 12px;">€€</td>
                <td style="padding: 12px;">Airport</td>
              </tr>
              <tr>
                <td style="padding: 12px;"><strong>Sunny Beach</strong></td>
                <td style="padding: 12px;">⭐</td>
                <td style="padding: 12px;">⭐⭐⭐⭐⭐</td>
                <td style="padding: 12px;">⭐⭐⭐⭐⭐</td>
                <td style="padding: 12px;">€</td>
                <td style="padding: 12px;">Budget</td>
              </tr>
            </tbody>
          </table>
        </div>

        <ZoneMap />

        <section class="glass-panel mb-4" id="area1">
          <h2>📍 Area 1: Burgas City (The Core)</h2>
          <p>The absolute premium choice for fans. Staying in the city means you are closest to the EuroVillage, the Arena, and the main afterparties. Demand here is the highest, and prices reflect that.</p>
          
          <div class="places-grid mt-3">
            <AccommodationCard 
              name="Zornitsa & Izgrev"
              type="Apartments"
              transitTime="🚶‍♂️ 10 min walk"
              priceTier="€€€€"
              description="Purely residential areas, but they are directly adjacent to Arena Burgas. The biggest advantage: you can literally walk home after the Grand Final instead of waiting hours for a taxi."
              whatToDo="Explore Park Veleka and enjoy a local, untouristed vibe. Not much nightlife, but you are sleeping right next to the Arena."
              transportInfo="5-10 minutes walking to Arena Burgas. No buses or taxis needed!"
              bookingUrl="https://www.booking.com/searchresults.html?ss=Zornitsa,+Burgas,+Bulgaria" 
              insiderNote="There are no hotels here, only apartments (AirBnb/Booking). Book immediately, they will sell out first."
            />
            <AccommodationCard 
              name="Lazur"
              type="Hotel / Apt"
              transitTime="🚶‍♂️ 25 min walk"
              priceTier="€€€"
              description="The most beautiful neighborhood in Burgas, right next to the Sea Garden. It's a longer walk to the Arena, but you get the sea breeze and the best parks."
              whatToDo="Morning runs in the Sea Garden, Flora Expo Center, beachfront cafes, and premium coastal living."
              transportInfo="A pleasant 25-minute walk through the park to the Arena, or a quick 5-minute taxi ride."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Lazur,+Burgas,+Bulgaria" 
            />
            <AccommodationCard 
              name="City Center"
              type="Boutique Hotel"
              transitTime="🚕 15 min taxi"
              priceTier="€€€€"
              description="The heart of the action. Bars, restaurants, and the likely location of the EuroVillage. You will need a taxi or a dedicated shuttle to reach the Arena."
              whatToDo="EuroVillage, official EuroClub afterparties, museums, high-end dining, and the main entrance to the Sea Garden."
              transportInfo="Use the fast B1/B2 bus lines (they use dedicated bus lanes) to reach the Arena in 20 mins, or take a taxi."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Burgas+Center,+Bulgaria" 
              insiderNote="If you plan to party every night at the EuroClub, this is your spot."
            />
            <AccommodationCard 
              name="Sarafovo"
              type="Coastal Suburb"
              transitTime="🚕 15 min taxi"
              priceTier="€€"
              description="Sarafovo is the neighborhood directly adjacent to Burgas Airport (BOJ). Excellent logistics for flying in, but a longer commute to the Arena."
              whatToDo="Aviation Museum, wide sandy beaches, and a quiet, family-friendly atmosphere away from the city noise."
              transportInfo="Take City Bus #15 directly to Burgas center. By car/taxi, it's about 15 minutes to Arena Burgas."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Sarafovo,+Bulgaria" 
            />
            <AccommodationCard 
              name="Kraimorie"
              type="Suburban Beach"
              transitTime="🚕 25 min taxi"
              priceTier="€€"
              description="A southern coastal neighborhood of Burgas. It offers a very relaxed beach vibe, but it is located on the opposite side of the city from the Arena."
              whatToDo="Quiet beach days and visiting the nearby Chengene Skele fishing village for authentic seafood."
              transportInfo="City Bus #17 connects Kraimorie to the South Bus Station. To reach the Arena, you must cross the entire city (20-25 mins by car)."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Kraimorie,+Bulgaria" 
            />
          </div>
          
          <div class="red-flag-zone mt-3" style="background: rgba(255, 184, 0, 0.1); border-left: 4px solid var(--accent-amber);">
            <h3 style="color: var(--accent-amber); margin-bottom: 8px;">⚠️ Areas to Book with Caution</h3>
            <p style="font-size: 0.95rem; margin-bottom: 12px;">You might find extremely cheap apartments in <strong>Meden Rudnik</strong> and <strong>Pobeda</strong>. Before booking, keep these local nuances in mind:</p>
            <ul style="font-size: 0.9rem; padding-left: 20px; margin-bottom: 12px;">
              <li style="margin-bottom: 8px;"><strong>Meden Rudnik (Zones A & B):</strong> The most developed and greenest parts of the district with better transport links. If you must stay here, choose these zones.</li>
              <li style="margin-bottom: 8px;"><strong>Meden Rudnik (Zone V / В):</strong> Actively developing with new complexes, but you may face unpaved access roads, limited parking, and heavy rush-hour traffic on the way into the city.</li>
              <li><strong>Pobeda:</strong> An industrial district on the edge of the city. Poorly connected for late-night returns from the Arena and a long way from anything you came for.</li>
            </ul>
            <p style="font-size: 0.85rem; opacity: 0.8; margin: 0;"><em>Note: Meden Rudnik is the furthest point from the Arena. While cheap, you may spend the savings on long taxi rides across the city.</em></p>
          </div>
        </section>

        <section class="glass-panel mb-4" id="area2">
          <h2>🏖️ Area 2: The North Coast (Resorts)</h2>
          <p>The coastline north of Burgas offers incredible resorts and cheaper prices. The trade-off? You MUST arrange a reliable transfer back after midnight, as public buses stop running.</p>
          
          <div class="places-grid mt-3">
            <AccommodationCard 
              name="Pomorie"
              type="Coastal Town"
              transitTime="🚕 30 min taxi"
              priceTier="€€"
              description="A separate coastal town built on a peninsula. Known for its salt lakes and relaxed vibe. Excellent logistics for flying in."
              whatToDo="Visit the Salt Museum, try the famous healing mud baths, and explore the charming old town."
              transportInfo="Intercity buses depart from Burgas South Bus Station every 30 mins. By car, it's a 30-minute drive to the Arena."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Pomorie,+Bulgaria" 
            />
            <AccommodationCard 
              name="Sunny Beach"
              type="Mega Resort"
              transitTime="🚕 40 min taxi"
              priceTier="€"
              description="The biggest resort in Bulgaria. Thousands of cheap hotels, massive clubs, and endless beaches. It's further away, but offers the best budget options."
              whatToDo="Massive nightlife, huge beach bars, and non-stop summer parties."
              transportInfo="Direct intercity buses from Burgas South Bus Station take about 45 minutes. By car/taxi, it's a 40-minute drive."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Sunny+Beach,+Bulgaria" 
              insiderNote="The official Eurovision shuttles will likely have a major hub here. Great for budget fans."
            />
            <AccommodationCard 
              name="Sveti Vlas"
              type="Premium Resort"
              transitTime="🚕 45 min taxi"
              priceTier="€€€€"
              description="Nestled between the mountains and the sea, Sveti Vlas is the luxury alternative to Sunny Beach, offering premium yacht-club vibes."
              whatToDo="Stroll around the Marina Dinevi yacht port, enjoy high-end dining, and hike the nearby eco-trails."
              transportInfo="Take a bus to Sunny Beach and transfer, or drive for 45+ minutes to reach Burgas Arena."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Sveti+Vlas,+Bulgaria" 
            />
            <AccommodationCard 
              name="Nessebar (Old Town)"
              type="UNESCO Heritage"
              transitTime="🚕 45 min taxi"
              priceTier="€€€"
              description="One of the oldest towns in Europe, situated on a rocky peninsula. Highly romantic, but requires a long drive to the Arena."
              whatToDo="Explore ancient wooden houses, Byzantine church ruins, and incredible seafood restaurants right on the cliffs."
              transportInfo="Buses run from Burgas South Bus Station. A taxi or rental car will take about 45 minutes to the Arena."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Old+Town+Nessebar,+Bulgaria" 
            />
          </div>
        </section>

        <section class="glass-panel" id="area3">
          <h2>🌅 Area 3: The South Coast (Authentic Riviera)</h2>
          <p>The southern coast is more dramatic, authentic, and arguably more beautiful. However, because Arena Burgas is in the extreme North of the city, staying in the South means crossing the entire city for every show.</p>
          
          <div class="places-grid mt-3">
            <AccommodationCard 
              name="Sozopol"
              type="Boutique Hotel"
              transitTime="🚕 50 min taxi"
              priceTier="€€€"
              description="One of the oldest towns in Europe with stunning wooden houses and incredible seafood. Ideal for delegations or fans who want a true vacation."
              whatToDo="Wander the cobblestone streets of the Old Town, eat fresh Black Sea mussels, and visit the fairytale Ravadinovo Castle."
              transportInfo="Buses to Burgas depart every 30 minutes, but it takes 45-50 minutes by car to cross Burgas and reach the Arena."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Sozopol,+Bulgaria" 
              insiderNote="WARNING: The drive from Sozopol to the Arena takes about 45-50 minutes. Book here only if you rent a car or hire a private driver."
            />
            <AccommodationCard 
              name="Chernomorets"
              type="Coastal Village"
              transitTime="🚕 35 min taxi"
              priceTier="€€"
              description="A quieter alternative to Sozopol, slightly closer to Burgas. Great beaches and a very relaxed atmosphere."
              whatToDo="Relax on Vromos beach and enjoy a slower, family-friendly coastal pace without the tourist crowds."
              transportInfo="Intercity buses are available, but a taxi or rental car (35 mins) is highly recommended for late-night Arena returns."
              bookingUrl="https://www.booking.com/searchresults.html?ss=Chernomorets,+Bulgaria" 
            />
          </div>
        </section>
      </div>

      <aside class="sidebar">
        <div class="glass-panel sticky-box">
          <h3>Secure Your Stay</h3>
          <p>Availability is dropping rapidly. Jump to your preferred zone:</p>
          
          <div class="zone-filters" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
            <a href="#area1" onclick="document.getElementById('area1').scrollIntoView({behavior: 'smooth'})" class="btn btn-secondary" style="font-size: 0.9rem; text-align: left;">🎤 Hotels Near Arena</a>
            <a href="#area2" onclick="document.getElementById('area2').scrollIntoView({behavior: 'smooth'})" class="btn btn-secondary" style="font-size: 0.9rem; text-align: left;">🏖️ North Coast Resorts</a>
            <a href="#area3" onclick="document.getElementById('area3').scrollIntoView({behavior: 'smooth'})" class="btn btn-secondary" style="font-size: 0.9rem; text-align: left;">🌅 Southern Riviera</a>
          </div>

          <AffiliateButton text="Search All Regions" href="https://www.booking.com/searchresults.html?ss=Burgas+Province,+Bulgaria" provider="booking" />
          
          <hr style="margin: 24px 0; border-color: var(--glass-border);" />
          
          <h4>The Transport Warning</h4>
          <p style="font-size: 0.85rem; margin-bottom: 12px; color: var(--text-muted);">
            If you book outside of Burgas city limits, <strong>do not rely on public transport after 23:00</strong>. The Eurovision shows end late. Book a rental car or an official shuttle.
          </p>
          <a href="/transfers" class="btn btn-secondary" style="width: 100%; text-align: center; display: inline-block;">Read Transit Guide</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    padding: 64px 24px;
  }
  
  h1 {
    font-size: 3rem;
    margin-bottom: 16px;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 800px;
    margin-bottom: 48px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
  }

  .mb-4 {
    margin-bottom: 48px;
  }

  .mt-3 {
    margin-top: 24px;
  }

  h2 {
    color: var(--accent-cyan);
    margin-bottom: 16px;
    font-size: 1.5rem;
    border-bottom: 1px solid rgba(0, 240, 255, 0.2);
    padding-bottom: 8px;
    scroll-margin-top: 100px; /* offset for sticky header */
  }

  .places-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .red-flag-zone {
    padding: 16px;
    background: rgba(255, 68, 68, 0.1);
    border-left: 4px solid #ff4444;
    border-radius: 4px;
  }

  .sticky-box {
    position: sticky;
    top: 100px;
  }

  .sticky-box h3 {
    color: var(--accent-magenta);
    margin-bottom: 8px;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
