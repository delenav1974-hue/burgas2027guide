---
import Layout from '../../layouts/Layout.astro';
import HeroCapture from '../../components/HeroCapture.astro';
import CountdownBanner from '../../components/CountdownBanner.astro';
import TransitCalculator from '../../components/TransitCalculator.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { getCollection } from 'astro:content';
import { eventSchema } from '../../config/site';

const targetDate = "2027-05-15T20:00:00+03:00";

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout
  title="Евровизия 2027 в Бургас — независим наръчник за настаняване и транспорт"
  description="Къде да отседнете в Бургас за Евровизия 2027, как да стигнете от летищата в Бургас, София и Истанбул, какво се случва в града. Наръчник от местни, без туристически капани."
  schema={eventSchema}
>
  <div class="container">
    <HeroCapture
      headline="Евровизия 2027 в Бургас: наръчник от местни"
      subheadline="Независим поглед от хората, които живеят на това крайбрежие: настаняване, транспорт и градът по време на най-голямото музикално събитие на Черно море."
    />

    <div class="quick-links glass-panel" style="margin-top: -32px; margin-bottom: 32px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; padding: 24px;">
      <a href="/bg/where-to-stay/" class="btn btn-secondary">🏨 Намерете настаняване</a>
      <a href="/bg/transfers/" class="btn btn-secondary">🚕 Трансфер от летището</a>
      <a href="/essential-apps/" class="btn btn-secondary">📱 Мобилен интернет и eSIM (EN)</a>
        <AffiliateButton text="💳 Карта за пътуване (Revolut)" href="https://revolut.com/referral/?referral-code=elena02b5!AUG1-26-AR-LL&geo-redirect" provider="generic" />
    </div>

    <CountdownBanner targetDate={targetDate} />

    <section class="features">
      <div class="feature-card glass-panel">
        <h3>📍 Къде да отседнете</h3>
        <p>Без туристическите капани. Разглеждаме <strong>хотелите на пешеходно разстояние от Арена Бургас</strong> и крайбрежните селища с шатъл до залата.</p>
<a href="/bg/where-to-stay/" class="btn btn-primary" style="margin-top:16px;">Наръчник за настаняване</a>
      </div>

      <div class="feature-card glass-panel">
        <h3>🚕 Транспорт и логистика</h3>
        <p>Как да стигнете, без да надплащате: от <strong>автобуса от летище Истанбул до Бургас</strong> до нощните шатъли след шоуто.</p>
        <TransitCalculator />
        <a href="/bg/transfers/" class="btn btn-primary" style="margin-top:16px;">Транспортен наръчник</a>
      </div>

      <div class="feature-card glass-panel">
        <h3>🪩 Събития и партита</h3>
        <p>EuroVillage, официалните афтърпартита на EuroClub и партита на яхти от пристанище Бургас.</p>
        <a href="/events-and-parties/" class="btn btn-primary" style="margin-top:16px; display: block;">Програма (EN)</a>
      </div>
    </section>

    {latestNews.length > 0 && (
      <section class="latest-news-section glass-panel" style="margin: 64px 0; padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <h2 style="color: var(--accent-magenta); font-size: 2rem;">Последни новини</h2>
          <a href="/news/" style="color: var(--accent-cyan); font-weight: 600;">Всички новини (EN) &rarr;</a>
        </div>
        <div class="news-list" style="display: flex; flex-direction: column; gap: 16px;">
          {latestNews.map((post) => (
            <a href={`/news/${post.id}/`} class="news-item" style="display: block; padding: 16px; background: rgba(0,0,0,0.3); border-radius: 8px; text-decoration: none; border: 1px solid var(--glass-border); transition: border-color 0.2s;">
              <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
                {post.data.date.toLocaleDateString('bg-BG', { month: 'long', day: 'numeric', year: 'numeric' })}
              </div>
              <h3 style="color: var(--text-main); margin-bottom: 8px; font-size: 1.2rem;">{post.data.title}</h3>
              <p style="color: var(--text-muted); font-size: 0.95rem;">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    margin: 64px 0;
  }

  .feature-card h3 {
    color: var(--accent-amber);
    margin-bottom: 16px;
    font-size: 1.5rem;
  }

  .feature-card p {
    font-size: 1.05rem;
    margin-bottom: 24px;
  }

  .news-item:hover {
    border-color: var(--accent-cyan) !important;
  }
</style>
