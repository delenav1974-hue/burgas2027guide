---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout 
  title={`${entry.data.title} | Burgas 2027 News`}
  description={entry.data.description}
>
  <div class="container page-content">
    <a href="/news" class="back-link">&larr; Back to News</a>
    
    <article class="glass-panel article-container">
      <header class="article-header">
        <div class="news-meta">
          <span class="date">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="author">By {entry.data.author}</span>
        </div>
        <h1 class="text-gradient">{entry.data.title}</h1>
      </header>

      <div class="article-body">
        <Content />
      </div>
      
      <hr style="margin: 48px 0; border-color: var(--glass-border);" />
      
      <div class="article-footer">
        <h3>Need to book your trip?</h3>
        <p>Don't wait until the official tickets drop. Accommodation and transit will sell out.</p>
        <div style="display: flex; gap: 16px; margin-top: 16px; flex-wrap: wrap;">
          <AffiliateButton text="Find Hotels" href="/where-to-stay" provider="booking" />
          <AffiliateButton text="Book Airport Shuttle" href="/transfers" provider="kiwitaxi" />
        </div>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .page-content {
    padding: 64px 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: var(--accent-cyan);
    margin-bottom: 24px;
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-container {
    padding: 48px;
  }

  .article-header {
    margin-bottom: 48px;
  }

  .news-meta {
    display: flex;
    gap: 16px;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .article-header h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 0;
  }

  .article-body {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-main);
  }

  .article-body p {
    margin-bottom: 24px;
  }

  .article-body h2, .article-body h3 {
    color: var(--accent-amber);
    margin-top: 48px;
    margin-bottom: 16px;
  }
  
  .article-body strong {
    color: #fff;
  }

  .article-body a {
    color: var(--accent-magenta);
    text-decoration: none;
    font-weight: 600;
  }

  .article-body a:hover {
    text-decoration: underline;
  }

  .article-footer h3 {
    color: var(--accent-cyan);
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .article-container {
      padding: 24px;
    }
    .article-header h1 {
      font-size: 2rem;
    }
  }
</style>
