---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
// Sort by date descending
allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout 
  title="Eurovision 2027 News | Burgas Updates" 
  description="Latest news, logistics updates, and insider information for the Eurovision 2027 Song Contest in Burgas, Bulgaria."
  breadcrumb="News"
>
  <div class="container page-content">
    <h1 class="text-gradient">Latest Updates</h1>
    <p class="lead">Stay ahead of the crowd. Real-time logistics, ticket announcements, and insider news for Burgas 2027.</p>

    <div class="news-grid">
      {allNews.map((post) => (
        <a href={`/news/${post.id}`} class="news-card glass-panel">
          <div class="news-content">
            <div class="news-meta">
              <span class="date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <span class="author">By {post.data.author}</span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="read-more">Read Full Story &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-content {
    padding: 64px 24px;
  }
  
  h1 {
    font-size: 3rem;
    margin-bottom: 16px;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 800px;
    margin-bottom: 48px;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 800px;
  }

  .news-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -10px rgba(0, 240, 255, 0.2);
    border-color: var(--accent-cyan);
  }

  .news-content {
    padding: 24px;
  }

  .news-meta {
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .news-card h2 {
    color: var(--text-main);
    font-size: 1.5rem;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .news-card:hover h2 {
    color: var(--accent-cyan);
  }

  .news-card p {
    color: var(--text-muted);
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .read-more {
    color: var(--accent-magenta);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
