---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Eurovision Concierge Burgas | Individuelle Reiseplanung" 
  description="Beauftragen Sie einen lokalen Experten mit der Planung Ihrer Reise zum Eurovision Song Contest 2027 in Burgas. Hotelsuche, Restaurantreservierungen und VIP-Logistik."
  breadcrumb="Concierge"
>
  <div class="container page-content">
    <div style="text-align: center; max-width: 800px; margin: 0 auto 64px;">
      <h1 class="text-gradient" style="font-size: 3.5rem; margin-bottom: 24px;">Eurovision Concierge Burgas</h1>
      <p class="lead" style="font-size: 1.2rem; color: var(--text-muted);">Sie sprechen kein Bulgarisch? Keine Zeit für Recherchen? Überlassen Sie unseren lokalen Experten die Logistik. Wir sichern die besten Tische, versteckte Hotel-Perlen und reibungslose Transporte für Ihre Eurovision-Reise.</p>
    </div>

    <div class="services-grid">
      <!-- Tier 1 -->
      <div class="glass-panel concierge-tier">
        <h3>Reiseplanung</h3>
        <div class="price">€99 <span>/ Reise</span></div>
        <p>Perfekt für Individualreisende, die nur einen geprüften Reiseplan und Hotelempfehlungen benötigen.</p>
        <ul>
          <li>✅ Individueller digitaler Reiseplan</li>
          <li>✅ Hotelsuche (3 Optionen)</li>
          <li>✅ Logistikplan für den Transport</li>
          <li>✅ EuroVillage & Event-Guide</li>
          <li>❌ Restaurantreservierungen</li>
          <li>❌ On-Call-Support</li>
        </ul>
        <a href="#contact" class="btn btn-secondary">Service anfragen</a>
      </div>

      <!-- Tier 2 -->
      <div class="glass-panel concierge-tier popular">
        <div class="badge">Premium</div>
        <h3 style="color: var(--accent-magenta);">Premium Concierge</h3>
        <div class="price">€249 <span>/ Reise</span></div>
        <p>Wir übernehmen die harte Arbeit. Wir buchen Ihre Transfers, Abendessen und Tagesausflüge, damit Sie einfach anreisen können.</p>
        <ul>
          <li>✅ Alles aus der Reiseplanung</li>
          <li>✅ Buchung des Flughafentransfers</li>
          <li>✅ Restaurantreservierungen (Bis zu 3)</li>
          <li>✅ Ticket-Informationen & Alerts</li>
          <li>✅ Buchung von Tagesausflügen (Nessebar/Sozopol)</li>
          <li>❌ 24/7 WhatsApp-Support</li>
        </ul>
        <a href="#contact" class="btn btn-primary">Premium anfragen</a>
      </div>

      <!-- Tier 3 -->
      <div class="glass-panel concierge-tier">
        <h3 style="color: var(--accent-amber);">VIP Support</h3>
        <div class="price">€499 <span>/ Reise</span></div>
        <p>Null Reibung. Sie erhalten einen engagierten lokalen Fixer, der über WhatsApp erreichbar ist, um jedes Problem sofort zu lösen.</p>
        <ul>
          <li>✅ Alles aus Premium</li>
          <li>✅ 24/7 WhatsApp Lokaler Fixer</li>
          <li>✅ VIP Restaurant- & Club-Tische</li>
          <li>✅ Buchung privater Yachtcharter</li>
          <li>✅ Vermittlung von Privatfahrern für mehrere Tage</li>
          <li>✅ Notfall-Übersetzungsunterstützung</li>
        </ul>
        <a href="#contact" class="btn btn-secondary">VIP anfragen</a>
      </div>
    </div>

    <div class="glass-panel" id="contact" style="margin-top: 64px; max-width: 800px; margin-left: auto; margin-right: auto;">
      <h2 style="text-align: center; margin-bottom: 32px;">Beginnen Sie mit der Planung Ihrer Reise</h2>
      <form action="https://api.web3forms.com/submit" method="POST" class="concierge-form">
        <input type="hidden" name="access_key" value="03b548cb-5509-4e30-91a0-785800f9f395" />
        <input type="hidden" name="subject" value="New Concierge Request (DE)" />
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <input type="text" name="name" required placeholder="Ihr Name" />
          <input type="email" name="email" required placeholder="Ihre E-Mail" />
        </div>
        
        <select name="tier" style="width: 100%; margin-bottom: 16px;" required>
          <option value="" disabled selected>Wählen Sie eine Concierge-Stufe</option>
          <option value="Trip Planning (€99)">Reiseplanung (€99)</option>
          <option value="Premium (€249)">Premium (€249)</option>
          <option value="VIP (€499)">VIP (€499)</option>
          <option value="Delegation (€999+)">Delegation / Gruppe (€999+)</option>
        </select>

        <textarea name="details" rows="5" placeholder="Erzählen Sie uns von Ihrer Reise (Daten, Gruppengröße, wobei Sie Hilfe benötigen...)" style="width: 100%; margin-bottom: 24px;" required></textarea>
        
        <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1.1rem; padding: 16px;">ANFRAGE SENDEN</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .page-content { padding: 64px 24px; }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .concierge-tier { position: relative; padding: 40px 32px; display: flex; flex-direction: column; }
  .concierge-tier h3 { font-size: 1.8rem; margin-bottom: 8px; text-align: center; }
  .price { font-size: 2.5rem; font-weight: 800; text-align: center; margin-bottom: 24px; font-family: 'Outfit', sans-serif; }
  .price span { font-size: 1rem; color: var(--text-muted); font-weight: 400; }
  .concierge-tier p { color: var(--text-muted); margin-bottom: 32px; text-align: center; line-height: 1.6; }
  .concierge-tier ul { list-style: none; padding: 0; margin: 0 0 40px 0; flex-grow: 1; }
  .concierge-tier li { margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; }
  .concierge-tier.popular { border-top: 4px solid var(--accent-magenta); transform: scale(1.05); z-index: 10; box-shadow: 0 0 40px rgba(255, 0, 122, 0.1); }
  .badge { position: absolute; top: -16px; left: 50%; transform: translateX(-50%); background: var(--accent-magenta); color: white; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; }
  .concierge-tier a { text-align: center; width: 100%; }
  input, select, textarea { padding: 12px 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--glass-border); border-radius: 4px; color: var(--text-main); font-family: inherit; font-size: 1rem; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent-cyan); }
  @media (max-width: 900px) { .services-grid { grid-template-columns: 1fr; } .concierge-tier.popular { transform: none; } }
</style>
