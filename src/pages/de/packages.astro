---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Eurovision 2027 Burgas Pakete | Hotel & Transfer Deals" 
  description="Buchen Sie All-inclusive-Pakete für den Eurovision Song Contest 2027 in Burgas. Tarife: Essential, Fan, VIP und Delegation."
  breadcrumb="Pakete"
>
  <div class="container page-content">
    <div style="text-align: center; max-width: 800px; margin: 0 auto 64px;">
      <h1 class="text-gradient" style="font-size: 3.5rem; margin-bottom: 24px;">Eurovision 2027 Pakete</h1>
      <p class="lead" style="font-size: 1.2rem; color: var(--text-muted);">Überlassen Sie uns die Planung. Von einfacher Logistik bis hin zu All-inclusive-VIP-Behandlung – unser lokales Team hat die perfekten Burgas 2027-Pakete geschnürt.</p>
    </div>

    <div class="packages-grid">
      <!-- Essential -->
      <div class="package-card glass-panel">
        <div class="package-header">
          <h2>Essential</h2>
          <div class="price-tag">Ab €499<span>/Person</span></div>
        </div>
        <p class="pkg-desc">Das Nötigste. Sichern Sie sich Ihr Bett und die Fahrt vom Flughafen, bevor die Preise explodieren.</p>
        <ul class="pkg-features">
          <li>✅ 3 Nächte Unterkunft (3★ oder Apartment)</li>
          <li>✅ Flughafentransfer hin und zurück (BOJ/SOF/VAR)</li>
          <li>✅ Nahverkehrsplan & Guide</li>
          <li>❌ Restaurantreservierungen</li>
          <li>❌ Privatfahrer</li>
        </ul>
        <a href="/de/concierge" class="btn btn-secondary pkg-btn">REISE PLANEN</a>
      </div>

      <!-- Fan -->
      <div class="package-card glass-panel popular-tier">
        <div class="badge">Am beliebtesten</div>
        <div class="package-header">
          <h2 style="color: var(--accent-magenta);">Fan</h2>
          <div class="price-tag">Ab €899<span>/Person</span></div>
        </div>
        <p class="pkg-desc">Das ultimative Fan-Erlebnis. Wohnen Sie nah am Geschehen und besuchen Sie die besten offiziellen Events.</p>
        <ul class="pkg-features">
          <li>✅ 5 Nächte Unterkunft (4★ nah an der Arena)</li>
          <li>✅ Premium Flughafentransfer</li>
          <li>✅ EuroClub & EuroVillage Guide</li>
          <li>✅ 1x Kulturtour Schwarzes Meer</li>
          <li>❌ Privatfahrer für mehrere Tage</li>
        </ul>
        <a href="/de/concierge" class="btn btn-primary pkg-btn">REISE PLANEN</a>
      </div>

      <!-- VIP -->
      <div class="package-card glass-panel">
        <div class="package-header">
          <h2 style="color: var(--accent-amber);">VIP</h2>
          <div class="price-tag">Ab €1,999<span>/Person</span></div>
        </div>
        <p class="pkg-desc">Luxus an der Küste. Gehobene Gastronomie, private Yachten und null Logistikstress.</p>
        <ul class="pkg-features">
          <li>✅ 7 Nächte Premium-Hotel (5★ oder Resort)</li>
          <li>✅ Mercedes V-Klasse Flughafentransfer</li>
          <li>✅ VIP-Restaurantreservierungen (Täglich)</li>
          <li>✅ Private Yacht-Erfahrung</li>
          <li>✅ 24/7 lokaler Concierge-Support</li>
        </ul>
        <a href="/de/concierge" class="btn btn-secondary pkg-btn">VIP ANFRAGEN</a>
      </div>

      <!-- Delegation -->
      <div class="package-card glass-panel delegation-tier" style="grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; background: rgba(0, 240, 255, 0.05); border-color: rgba(0, 240, 255, 0.3);">
        <div>
          <h2 style="color: var(--accent-cyan); font-size: 2.5rem; margin-bottom: 16px;">Delegation & Presse</h2>
          <p class="pkg-desc" style="font-size: 1.1rem; margin-bottom: 24px;">Maßgeschneiderte Infrastruktur für offizielle Delegationen, große Pressegruppen und Unternehmenssponsoren.</p>
          <ul class="pkg-features" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <li>✅ Große Hotelkontingente (40+ Zimmer)</li>
            <li>✅ Kleinbus & Fahrer in Vollzeit</li>
            <li>✅ Engagierte Übersetzer / Dolmetscher</li>
            <li>✅ Private Proben- / Meetingräume</li>
            <li>✅ Privater Sicherheitsdienst & Eskorten</li>
            <li>✅ VIP Afterparty Organisation</li>
          </ul>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 1.2rem; margin-bottom: 24px; color: var(--text-muted);">Individuelle Preisgestaltung</div>
          <a href="/de/delegation-services" class="btn btn-primary" style="font-size: 1.2rem; padding: 16px 32px; display: inline-block;">B2B Dienstleistungen</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-content { padding: 64px 24px; }
  .packages-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .package-card { position: relative; padding: 40px 32px; display: flex; flex-direction: column; border-top: 4px solid var(--glass-border); }
  .popular-tier { border-top-color: var(--accent-magenta); transform: scale(1.02); box-shadow: 0 0 30px rgba(255, 0, 122, 0.15); }
  .badge { position: absolute; top: -16px; left: 50%; transform: translateX(-50%); background: var(--accent-magenta); color: white; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
  .package-header { margin-bottom: 24px; text-align: center; }
  .package-header h2 { font-size: 2rem; margin-bottom: 8px; }
  .price-tag { font-size: 2.5rem; font-weight: 800; font-family: 'Outfit', sans-serif; }
  .price-tag span { font-size: 1rem; color: var(--text-muted); font-weight: 400; }
  .pkg-desc { color: var(--text-muted); margin-bottom: 32px; text-align: center; line-height: 1.6; flex-grow: 0; }
  .pkg-features { list-style: none; padding: 0; margin: 0 0 40px 0; flex-grow: 1; }
  .pkg-features li { margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; }
  .pkg-features li:last-child { border-bottom: none; }
  .pkg-btn { text-align: center; width: 100%; display: block; padding: 14px 0; }
  @media (max-width: 1024px) { .packages-grid { grid-template-columns: 1fr; } .popular-tier { transform: none; } .delegation-tier { grid-template-columns: 1fr !important; text-align: center; } }
</style>
